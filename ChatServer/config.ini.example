[ChatServer]
Port=8081
Host=127.0.0.1
GrpcPort=50053
ChatPoolSize=3

[Redis]
Host=127.0.0.1
Port=6380
Password=YOUR_REDIS_PASSWORD

[MySQL]
Host=127.0.0.1
Port=33060
Database=wxchat
User=root
Password=YOUR_MYSQL_PASSWORD

[StatusServer]
Host=127.0.0.1
Port=50052
PoolSize=5

[MinIo]
Host=127.0.0.1
Port=9000
AccessKey=YOUR_MINIO_ACCESS_KEY
SecretKey=YOUR_MINIO_SECRET_KEY
Bucket=weixinchat

[AI_Agent]
ApiUrl=https://dashscope.aliyuncs.com/compatible-mode/v1
ApiKey=YOUR_ALIYUN_API_KEY
ModelName=qwen-plus

[Snowflake]
; Snowflake worker node ID — must be unique per ChatServer instance (range 0-1023)
; Used to generate globally unique, time-ordered 64-bit IDs for messages/records.
MachineID=1
