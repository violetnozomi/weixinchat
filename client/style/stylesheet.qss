#
/* ================= 全局字体与背景 ================= */
QDialog {
    background-color: #F5F5F5;
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 14px;
}

/* ================= 左侧列表区 (深色/浅色搭配) ================= */
QWidget#leftPanel {
    background-color: #ECECEC; /* 列表区浅灰底色 */
    border-right: 1px solid #DCDCDC;
}

/* 用户头像名字区 */
QWidget#userInfoWidget {
    background-color: #ECECEC; /* 与列表同色 */
    border-bottom: 1px solid #E0E0E0;
}

/* 标签页 (消息/联系人) 去除丑陋边框 */
QTabWidget::pane { border: none; }
QTabBar::tab {
    background: #ECECEC;
    color: #666666;
    padding: 10px 20px;
    border: none;
    font-weight: bold;
}
QTabBar::tab:selected {
    color: #07C160; /* 选中变绿 */
    background: #ECECEC;
    border-bottom: 2px solid #07C160;
}
QTabBar::tab:hover {
    background-color: #E0E0E0;
}

/* 列表控件去除虚线框 */
QListWidget {
    border: none;
    background-color: transparent;
    outline: none; /* 去掉选中时的虚线框 */
}
QListWidget::item {
    height: 60px; /* 列表项高度 */
    padding-left: 10px;
    color: #333;
}
QListWidget::item:hover {
    background-color: #D8D8D8; /* 悬停颜色 */
}
QListWidget::item:selected {
    background-color: #C6C6C6; /* 选中颜色 - 微信是深灰色 */
    color: #000;
}

/* ================= 右侧聊天区 ================= */
QWidget#rightPanel {
    background-color: #F5F5F5;
}

/* 顶部标题栏 */
QWidget#chatHeader {
    background-color: #F5F5F5;
    border-bottom: 1px solid #E7E7E7;
}
QLabel#chatTitleLabel {
    font-size: 18px; /* 标题字大一点 */
    font-weight: bold;
    color: #333;
}

/* 聊天记录框 - 关键：去掉边框 */
QTextEdit#chatEdit {
    border: none;
    background-color: #F5F5F5; /* 与背景融合 */
}

/* 工具栏 */
QWidget#toolBar {
    background-color: #F5F5F5;
    border-top: 1px solid #E7E7E7;
}
QPushButton {
    border: none;
    background: transparent;
    font-size: 18px;
}
QPushButton:hover {
    background-color: #E0E0E0;
    border-radius: 4px;
}

/* ================= 输入区 ================= */
QWidget#inputArea {
    background-color: #F5F5F5;
}
QTextEdit#inputEdit {
    border: none;
    background-color: #F5F5F5;
    font-size: 14px;
}

/* 发送按钮 - 微信经典样式 */
QPushButton#sendBtn {
    background-color: #E9E9E9; /* 默认是浅灰，输入内容后变绿(需代码控制) */
    color: #07C160;
    border: 1px solid #E0E0E0;
    border-radius: 4px;
    font-size: 14px;
    padding: 5px 20px;
}
/* 这里我们先默认设为绿色样式，让你看着爽 */
QPushButton#sendBtn {
    background-color: #07C160;
    color: white;
    border: none;
}
QPushButton#sendBtn:hover {
    background-color: #06AD56;
}

/* 滚动条美化 (像手机一样细) */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 8px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #C0C0C0;
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* ================================================================
   chatDialog — 整体界面美化
   ================================================================ */

QDialog#chatDialog {
    background-color: #ededed;
}

/* ---- 左侧 side_bar（深色导航栏） ---- */
#side_bar {
    background-color: rgb(42, 42, 42);
    min-width: 56px;
    max-width: 56px;
}

#side_bar #side_head_lb {
    border-radius: 20px;
}

#side_chat_lb[state='normal'] {
    border-image: url(:/res/chat_icon.png);
}
#side_chat_lb[state='hover'] {
    border-image: url(:/res/chat_icon_hover.png);
}
#side_chat_lb[state='pressed'],
#side_chat_lb[state='selected_normal'],
#side_chat_lb[state='selected_hover'],
#side_chat_lb[state='selected_pressed'] {
    border-image: url(:/res/chat_icon_press.png);
}

#side_contact_lb[state='normal'] {
    border-image: url(:/res/contact_list.png);
}
#side_contact_lb[state='hover'] {
    border-image: url(:/res/contact_list_hover.png);
}
#side_contact_lb[state='pressed'],
#side_contact_lb[state='selected_normal'],
#side_contact_lb[state='selected_hover'],
#side_contact_lb[state='selected_pressed'] {
    border-image: url(:/res/contact_list_press.png);
}

/* ---- 中间好友列表区 ---- */
#chat_user_widget {
    background-color: #f7f7f7;
    border-right: 1px solid #d4d4d4;
}

/* 搜索栏 */
#search_widget {
    background-color: #efefef;
    border-bottom: 1px solid #e0e0e0;
    min-height: 60px;
    max-height: 60px;
}

#search_edit {
    background-color: #e3e3e3;
    border: 1px solid transparent;
    border-radius: 6px;
    padding-left: 28px;
    font-size: 13px;
    min-height: 36px;
    max-height: 36px;
    color: #333;
    font-family: "Microsoft YaHei";
}
#search_edit:focus {
    background-color: #ffffff;
    border: 1px solid #07c160;
}

#search_btn {
    background-color: #d5d5d5;
    color: #444;
    border: none;
    border-radius: 6px;
    font-size: 12px;
    font-family: "Microsoft YaHei";
    min-width: 52px;
    max-width: 52px;
    min-height: 32px;
    max-height: 32px;
    padding: 0px;
}
#search_btn:hover  { background-color: #bebebe; color: #111; }
#search_btn:pressed { background-color: #ababab; }

/* Chat_User_List 好友列表 */
Chat_User_List {
    border: none;
    background: #f7f7f7;
    outline: none;
}
Chat_User_List::item {
    border: none;
    padding: 0px;
    margin: 0px;
}
Chat_User_List::item:selected { background-color: #d9d9d9; }
Chat_User_List::item:hover    { background-color: #e8e8e8; }

/* ---- 右侧聊天区 ---- */
#chat_data_widget {
    background-color: #f5f5f5;
}

/* 顶部标题栏 */
#widget_13 {
    background-color: #f5f5f5;
    border-bottom: 1px solid #dedede;
    min-height: 48px;
    max-height: 48px;
}
#titel_lb {
    background: transparent;
    font-size: 17px;
    font-weight: bold;
    color: #1a1a1a;
    font-family: "Microsoft YaHei";
    padding-left: 14px;
    letter-spacing: 1px;
}

/* 消息气泡区 */
#widget_12 {
    background-color: #ededed;
}

/* 表情/文件工具栏 */
#widget_9 {
    background-color: #f5f5f5;
    border-top:    1px solid #e0e0e0;
    border-bottom: 1px solid #e8e8e8;
    min-height: 40px;
    max-height: 40px;
}

#emo_lb[state='normal'] { border-image: url(:/res/smile.png); }
#emo_lb[state='hover']  { border-image: url(:/res/smile_hover.png); }
#emo_lb[state='press']  { border-image: url(:/res/smile_press.png); }

