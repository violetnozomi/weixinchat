
QDialog#LoginDialog,#RegisterDialog,#ResetDialog,#ForgetDialog{
background-color:rgb(255,255,255)
}

#user_label,#pass_label{
   color:black;
}

#err_tip[state='normal']{
   color: #2ecc71;
   font-weight: bold;
}

#err_tip[state='err']{
   color: #e74c3c;
   font-weight: bold;
}

/* 重置密码界面标题样式 */
#title_label{
   color: rgb(42, 112, 241);
   font-weight: bold;
   font-size: 18pt;
}

/* 重置密码界面标签样式 */
ForgetDialog #user_label,
ForgetDialog #email_label,
ForgetDialog #varify_label,
ForgetDialog #new_pwd_label{
   color: #34495e;
   font-weight: bold;
}

/* 重置密码界面输入框样式 */
ForgetDialog QLineEdit{
   border: 1px solid #dcdfe6;
   border-radius: 4px;
   padding-left: 5px;
   background-color: white;
}

ForgetDialog QLineEdit:focus{
   border: 1px solid rgb(42, 112, 241);
}

/* 重置密码界面按钮样式 */
#confirm_btn{
   background-color: rgb(42, 112, 241);
   color: white;
   border-radius: 4px;
   border: none;
   font-weight: bold;
}

#confirm_btn:hover{
   background-color: rgb(60, 130, 255);
}

#confirm_btn:pressed{
   background-color: rgb(30, 90, 220);
}

#cancel_btn{
   background-color: #ecf0f1;
   color: #34495e;
   border-radius: 4px;
   border: 1px solid #bdc3c7;
   font-weight: bold;
}

#cancel_btn:hover{
   background-color: #d5dbdb;
}

#cancel_btn:pressed{
   background-color: #bdc3c7;
}

/* 返回登录链接样式 */
#return_login_label[state='normal'],#return_login_label[state='selected']{
    color: #7f8c8d;
}

#return_login_label[state='hover'], #return_login_label[state='selected_hover']{
    color: rgb(42, 112, 241);
    font-weight: bold;
}

/* 获取验证码按钮样式 */
#varify_btn{
   background-color: white;
   color: rgb(42, 112, 241);
   border: 1px solid rgb(42, 112, 241);
   border-radius: 4px;
   font-weight: bold;
}

#varify_btn:hover{
   background-color: rgb(42, 112, 241);
   color: white;
}

#varify_btn:pressed{
   background-color: rgb(30, 90, 220);
}

#varify_btn:disabled{
   background-color: #ecf0f1;
   color: #95a5a6;
   border: 1px solid #bdc3c7;
}

/* 登录界面样式 */
LoginDialog #user_label,
LoginDialog #pass_label{
   color: #34495e;
   font-weight: bold;
}

LoginDialog QLineEdit{
   border: 1px solid #dcdfe6;
   border-radius: 4px;
   padding-left: 5px;
   background-color: white;
}

LoginDialog QLineEdit:focus{
   border: 1px solid rgb(42, 112, 241);
}

#login_btn{
   background-color: rgb(42, 112, 241);
   color: white;
   border-radius: 4px;
   border: none;
   font-weight: bold;
   font-size: 11pt;
}

#login_btn:hover{
   background-color: rgb(60, 130, 255);
}

#login_btn:pressed{
   background-color: rgb(30, 90, 220);
}

#Register_label[state='normal'],#Register_label[state='selected']{
    color: rgb(42, 112, 241);
}

#Register_label[state='hover'], #Register_label[state='selected_hover']{
    color: rgb(60, 130, 255);
    font-weight: bold;
}

/* 注册界面样式 */
RegisterDialog #reg_title_label{
   color: rgb(42, 112, 241);
   font-weight: bold;
   font-size: 18pt;
}

RegisterDialog #user_label,
RegisterDialog #pwd_lable,
RegisterDialog #email_label,
RegisterDialog #CAPTCHA_lable,
RegisterDialog #pwd_con_lable{
   color: #34495e;
   font-weight: bold;
}

RegisterDialog QLineEdit{
   border: 1px solid #dcdfe6;
   border-radius: 4px;
   padding-left: 5px;
   background-color: white;
}

RegisterDialog QLineEdit:focus{
   border: 1px solid rgb(42, 112, 241);
}

#certain_btn{
   background-color: rgb(42, 112, 241);
   color: white;
   border-radius: 4px;
   border: none;
   font-weight: bold;
}

#certain_btn:hover{
   background-color: rgb(60, 130, 255);
}

#certain_btn:pressed{
   background-color: rgb(30, 90, 220);
}

RegisterDialog #cancel_btn{
   background-color: #ecf0f1;
   color: #34495e;
   border-radius: 4px;
   border: 1px solid #bdc3c7;
   font-weight: bold;
}

RegisterDialog #cancel_btn:hover{
   background-color: #d5dbdb;
}

RegisterDialog #cancel_btn:pressed{
   background-color: #bdc3c7;
}

#get_code{
   background-color: white;
   color: rgb(42, 112, 241);
   border: 1px solid rgb(42, 112, 241);
   border-radius: 4px;
   font-weight: bold;
}

#get_code:hover{
   background-color: rgb(42, 112, 241);
   color: white;
}

#get_code:pressed{
   background-color: rgb(30, 90, 220);
}

#get_code:disabled{
   background-color: #ecf0f1;
   color: #95a5a6;
   border: 1px solid #bdc3c7;
}

RegisterDialog #tip_label{
   color: #7f8c8d;
}

RegisterDialog #return_login_label[state='normal'],RegisterDialog #return_login_label[state='selected']{
    color: rgb(42, 112, 241);
}

RegisterDialog #return_login_label[state='hover'], RegisterDialog #return_login_label[state='selected_hover']{
    color: rgb(60, 130, 255);
    font-weight: bold;
}





