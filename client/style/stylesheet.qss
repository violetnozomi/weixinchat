}

#fpp_name_lb {
    font-size: 20px;
    font-weight: bold;
    font-family: "Microsoft YaHei";
    color: #1a1a1a;
    background: transparent;
}

#fpp_uid_lb {
    font-size: 13px;
    color: #888888;
    font-family: "Microsoft YaHei";
    background: transparent;
}

#fpp_sig_lb {
    font-size: 13px;
    color: #aaaaaa;
    font-style: italic;
    font-family: "Microsoft YaHei";
    background: transparent;
}

#fpp_divider {
    color: #eeeeee;
    background-color: #eeeeee;
    max-height: 1px;
}

#fpp_msg_btn {
    background-color: #07c160;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 15px;
    font-family: "Microsoft YaHei";
    font-weight: bold;
}
#fpp_msg_btn:hover   { background-color: #06ad56; }
#fpp_msg_btn:pressed { background-color: #059a4d; }
#ContactListPanel {
    background-color: #f7f7f7;
    border-right: 1px solid #e0e0e0;
}

/* "新的朋友"图标背景圆 */
#contact_newf_icon {
    background-color: #07c160;
    border-radius: 20px;
}

#contact_newf_text {
    font-size: 15px;
    font-family: "Microsoft YaHei";
    color: #1a1a1a;
    background: transparent;
}

/* 红色徽标 */
#contact_badge_lb {
    background-color: #fa4b37;
    color: white;
    border-radius: 10px;
    font-size: 11px;
    font-family: "Microsoft YaHei";
    font-weight: bold;
}

/* ═══════════════════════════════════════════════════════════════
   好友验证面板（FriendVerifyPanel）
   ═══════════════════════════════════════════════════════════════ */
#FriendVerifyPanel {
    background-color: #f9f9f9;
}

#fvp_title_bar {
    background-color: #f9f9f9;
    border-bottom: 1px solid #e8e8e8;
}

#fvp_title_lb {
    font-size: 16px;
    font-weight: bold;
    font-family: "Microsoft YaHei";
    color: #1a1a1a;
}

#fvp_divider {
    color: #e0e0e0;
    background-color: #e0e0e0;
    max-height: 1px;
}

#fvp_empty_lb {
    font-size: 14px;
    color: #bbbbbb;
    font-family: "Microsoft YaHei";
    background: transparent;
}

/* ═══════════════════════════════════════════════════════════════
   好友申请行（FriendRequestItem）
   ═══════════════════════════════════════════════════════════════ */
#fri_req_name {
    font-size: 14px;
    font-weight: bold;
    font-family: "Microsoft YaHei";
    color: #1a1a1a;
    background: transparent;
}

#fri_req_msg {
    font-size: 12px;
    color: #888888;
    font-family: "Microsoft YaHei";
    background: transparent;
}

#fri_req_time {
    font-size: 11px;
    color: #bbbbbb;
    font-family: "Microsoft YaHei";
    background: transparent;
}

/* 接受按钮 */
#fri_accept_btn {
    background-color: #07c160;
    color: white;
    border: none;
    border-radius: 4px;
    font-size: 13px;
    font-family: "Microsoft YaHei";
}
#fri_accept_btn:hover   { background-color: #06ad56; }
#fri_accept_btn:pressed { background-color: #059a4d; }

/* 拒绝按钮 */
#fri_reject_btn {
    background-color: #ffffff;
    color: #555555;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    font-size: 13px;
    font-family: "Microsoft YaHei";
}
#fri_reject_btn:hover   { background-color: #f5f5f5; border-color: #b0b0b0; }
#fri_reject_btn:pressed { background-color: #ebebeb; }

/* 状态标签（已添加 / 已拒绝） */
#fri_status_lb[status='accepted'] {
    color: #07c160;
    font-size: 13px;
    font-family: "Microsoft YaHei";
    background: transparent;
}
#fri_status_lb[status='rejected'] {
    color: #aaaaaa;
    font-size: 13px;
    font-family: "Microsoft YaHei";
    background: transparent;
}

/* AddFriendWidget 对话框（好友申请发送界面） */
#AddFriendWidget {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
}
#afw_name_lb {
    font-size: 16px;
    font-weight: bold;
    font-family: "Microsoft YaHei";
    color: #1a1a1a;
}
#afw_hint_lb {
    font-size: 12px;
    color: #888888;
    font-family: "Microsoft YaHei";
}
#afw_msg_edit {
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    font-size: 13px;
    font-family: "Microsoft YaHei";
    background-color: #f9f9f9;
    color: #333333;
}
#afw_msg_edit:focus {
    border: 1px solid #07c160;
    background-color: #ffffff;
}
#afw_send_btn {
    background-color: #07c160;
    color: white;
    border: none;
    border-radius: 4px;
    font-size: 14px;
    font-family: "Microsoft YaHei";
    font-weight: bold;
}
#afw_send_btn:hover   { background-color: #06ad56; }
#afw_send_btn:pressed { background-color: #059a4d; }
#afw_cancel_btn {
    background-color: #ffffff;
    color: #555555;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    font-size: 14px;
    font-family: "Microsoft YaHei";
}
#afw_cancel_btn:hover   { background-color: #f5f5f5; }
#afw_cancel_btn:pressed { background-color: #ebebeb; }

