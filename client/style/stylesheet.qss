}

/* Chat_User_List 列表样式 */
Chat_User_List {
    border: none;
    background: white;
    outline: none;
}

Chat_User_List::item {
    border: none;
    padding: 0px;
    margin: 0px;
}

Chat_User_List QScrollBar:vertical {
    border: none;
    background: #F5F5F5;
    width: 8px;
    border-radius: 4px;
}

Chat_User_List QScrollBar::handle:vertical {
    background: #C0C0C0;
